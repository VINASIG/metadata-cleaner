---
import { Upload, Download, Trash, FileSearch } from '@lucide/astro';
import SiteFooter from './SiteFooter.astro';
import MetadataTools from './MetadataTools.astro';
import MetadataPager from './MetadataPager.astro';
import SitePreferences from './SitePreferences.astro';
import ThemeInit from './ThemeInit.astro';
import { copy } from '../lib/copy.ts';
import { mode, origin, repository } from '../lib/site.ts';
import '../styles/tokens.css';
import '../styles/app.css';
import '../styles/control-surfaces.css';
import '../styles/metadata.css';
import '../styles/site-chrome.css';
interface Props {
  lang: 'vi' | 'en';
}
const { lang } = Astro.props;
const c = copy[lang];
const title = mode === 'cleaner' ? c.cleanerTitle : c.readerTitle;
const description =
  mode === 'cleaner' ? c.cleanerDescription : c.readerDescription;
const canonical = origin + (lang === 'en' ? 'en/' : '');
const revision = process.env['GITHUB_SHA'];
const source =
  revision && /^[a-f0-9]{40}$/.test(revision)
    ? `${repository}/tree/${revision}`
    : repository;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  url: canonical,
  description,
  inLanguage: lang,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Web browser',
  isAccessibleForFree: true,
  publisher: {
    '@type': 'Organization',
    name: 'VINASIG',
    url: 'https://vinasig.io.vn/',
  },
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <ThemeInit />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="no-referrer" />
    {revision && <meta name="source-revision" content={revision} />}
    <title>{title} | VINASIG</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="vi" href={origin} />
    <link rel="alternate" hreflang="en" href={`${origin}en/`} />
    <link rel="alternate" hreflang="x-default" href={origin} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | VINASIG`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
    <link rel="icon" type="image/svg+xml" href="/brand/mark.svg" />
    {[16, 32, 48].map((size) => (
      <link
        rel="icon"
        type="image/png"
        sizes={`${size}x${size}`}
        href={`/brand/favicon-${size}.png`}
      />
    ))}
    <link
      rel="preload"
      href="/fonts/SpaceGrotesk-VariableFont_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/font.css" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body data-language={lang} data-mode={mode}>
    <a class="skip-link" href="#tool">
      {c.skip}
    </a>
    <div class="app-shell" data-site-shell>
      <header class="site-header" data-site-header>
        <a
          class="brand"
          data-brand-logo
          href="https://vinasig.io.vn/"
          aria-label={c.home}
        >
          <picture>
            <source
              media="(prefers-color-scheme: dark)"
              srcset="/brand/reversed.svg"
            />
            <script is:inline>
              document.currentScript?.previousElementSibling?.setAttribute(
                'media',
                document.documentElement.dataset.theme === 'dark'
                  ? 'all'
                  : 'not all',
              );
            </script>
            <img
              src="/brand/primary-color.svg"
              alt="VINASIG"
              width="540"
              height="140"
            />
          </picture>
        </a>
        <SitePreferences lang={lang} alternate={lang === 'vi' ? '/en/' : '/'} />
      </header>
      <main>
        <section class="intro" aria-labelledby="page-title">
          <h1 id="page-title">{title}</h1>
          <p>{description}</p>
        </section>
        <div id="tool" class="workspace">
          <section class="editor" aria-labelledby="input-title">
            <h2 id="input-title" class="sr-only">
              {c.inputTitle}
            </h2>
            <div id="dropzone" class="dropzone">
              <label class="file-trigger">
                <Upload size={20} aria-hidden="true" />
                {c.choose}
                <input
                  id="file"
                  type="file"
                  aria-describedby="file-help"
                  disabled
                />
              </label>
              <p id="file-help" class="supporting">
                {c.drop} {mode === 'cleaner' ? c.cleanerTypes : c.readerTypes}
              </p>
            </div>
            <div class="input-feedback">
              <p class="supporting privacy">{c.privacy}</p>
              <button type="button" id="clear" class="clear-button" disabled>
                <Trash size={18} aria-hidden="true" />
                {c.clear}
              </button>
            </div>
            <p id="status" class="status" role="status" aria-live="polite">
              {c.statusEmpty}
            </p>
            <noscript>
              <p>{c.noScript}</p>
            </noscript>
            <section
              id="file-info"
              class="file-info"
              aria-labelledby="overview-title"
              hidden
            >
              <h2 id="overview-title" class="sr-only">
                {c.overview}
              </h2>
              <div class="file-overview">
                <figure id="source-figure" hidden>
                  <img
                    id="source-preview"
                    src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                    alt={c.originalPreview}
                    hidden
                  />
                  <figcaption class="supporting">
                    {c.originalPreview}
                  </figcaption>
                </figure>
                <div class="file-summary">
                  <h2 id="selected-file-name" data-user-content>
                    {c.overview}
                  </h2>
                  <dl class="summary-facts">
                    <div>
                      <dt>{c.format}</dt>
                      <dd id="file-format" data-user-content></dd>
                    </div>
                    <div>
                      <dt>{c.fileSize}</dt>
                      <dd id="file-size" data-user-content></dd>
                    </div>
                    <div id="dimension-fact" hidden>
                      <dt>{c.dimensions}</dt>
                      <dd id="file-dimensions" data-user-content></dd>
                    </div>
                    <div>
                      <dt>{c.metadataTitle}</dt>
                      <dd id="file-tags"></dd>
                    </div>
                  </dl>
                  <details class="browser-details">
                    <summary>{c.browserInfo}</summary>
                    <p class="supporting">{c.browserInfoHint}</p>
                    <dl id="file-facts" class="facts" data-user-content></dl>
                  </details>
                </div>
              </div>
              <section
                id="origin"
                class="origin"
                aria-labelledby="origin-title"
                hidden
              >
                <h3 id="origin-title">{c.origin}</h3>
                <p id="credentials-note" class="credential-note" hidden>
                  <strong>{c.credentials}</strong> {c.credentialsHint}
                </p>
                <dl id="origin-facts" class="facts" data-user-content></dl>
                <p id="origin-empty" class="supporting" hidden>
                  {c.originEmpty}
                </p>
                <details id="history" hidden>
                  <summary>{c.history}</summary>
                  <ol
                    id="recorded-actions"
                    class="history-list"
                    data-user-content
                  ></ol>
                </details>
              </section>
            </section>
          </section>
          {mode === 'cleaner' && (
            <section
              id="selection"
              class="selection"
              aria-labelledby="selection-title"
              hidden
            >
              <h2 id="selection-title">{c.selection}</h2>
              <p class="supporting">{c.selectionHint}</p>
              <div class="form-actions">
                <button id="all" type="button" class="quiet">
                  {c.all}
                </button>
                <button id="none" type="button" class="quiet">
                  {c.none}
                </button>
              </div>
              <p id="no-blocks" class="supporting" hidden>
                {c.noBlocks}
              </p>
              <fieldset id="choices">
                <legend class="sr-only">{c.selection}</legend>
              </fieldset>
              <p id="potential-savings" class="supporting"></p>
              <button id="process" class="primary" type="button" disabled>
                {c.remove}
              </button>
            </section>
          )}
          <section class="preview" aria-labelledby="result-title">
            <h2 id="result-title" class="sr-only">
              {mode === 'cleaner' ? c.outputTitle : c.metadataTitle}
            </h2>
            <p id="empty-result" class="empty-result">
              <FileSearch size={24} aria-hidden="true" />
              {c.statusEmpty}
            </p>
            <div id="result" hidden>
              {mode === 'cleaner' && (
                <>
                  <div id="clean-result" hidden>
                    <h2>{c.outputTitle}</h2>
                    <div class="processed-overview">
                      <div>
                        <dl id="sizes" class="facts size-facts"></dl>
                        <label for="filename">{c.filename}</label>
                        <input
                          type="text"
                          id="filename"
                          maxlength="120"
                          aria-describedby="name-help"
                          autocomplete="off"
                          spellcheck="false"
                        />
                        <p id="name-help" class="supporting">
                          {c.filenameHint}
                        </p>
                        <div class="form-actions">
                          <button
                            id="download"
                            class="primary"
                            type="button"
                            disabled
                          >
                            <Download size={18} aria-hidden="true" />
                            {c.download}
                          </button>
                        </div>
                        <p id="kept-choice" class="supporting"></p>
                      </div>
                      <img
                        id="image-preview"
                        src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                        alt={c.preview}
                        hidden
                      />
                    </div>
                    <p id="preview-unavailable" class="supporting" hidden>
                      {c.previewUnavailable}
                    </p>
                    <details id="verification">
                      <summary>{c.details}</summary>
                      <p>{c.same}</p>
                      <h3>{c.hash}</h3>
                      <dl id="hashes" class="facts" data-user-content></dl>
                    </details>
                  </div>
                  <div id="metadata-views" class="form-actions" hidden>
                    <button
                      id="view-original"
                      type="button"
                      class="group-button"
                      aria-pressed="true"
                    >
                      {c.originalMetadata}
                    </button>
                    <button
                      id="view-processed"
                      type="button"
                      class="group-button"
                      aria-pressed="false"
                      disabled
                    >
                      {c.processedMetadata}
                    </button>
                  </div>
                  <p id="current-view" class="supporting" hidden></p>
                </>
              )}
              <details id="metadata-details" open>
                <summary>{c.metadataTitle}</summary>
                <div class="metadata-toolbar">
                  <div class="search-field">
                    <label for="search">{c.search}</label>
                    <input type="search" id="search" autocomplete="off" />
                  </div>
                  <div class="form-actions report-actions">
                    <button id="copy-report" type="button" class="clear-button">
                      {c.copyReport}
                    </button>
                    <button id="report" type="button" class="clear-button">
                      <Download size={18} aria-hidden="true" />
                      {c.downloadReport}
                    </button>
                  </div>
                </div>
                <nav
                  id="metadata-groups"
                  class="metadata-groups"
                  aria-label={c.groups}
                ></nav>
                <p id="field-count" class="supporting" aria-live="polite"></p>
                <p class="supporting">{c.fieldsHint}</p>
                <MetadataPager lang={lang} position="above" />
                <div id="metadata-fields" class="metadata-fields"></div>
                <MetadataPager lang={lang} position="below" />
                <p id="no-results" class="supporting" hidden>
                  {c.noResults}
                </p>
              </details>
              <details id="protected" hidden>
                <summary>{mode === 'cleaner' ? c.locked : c.structure}</summary>
                <p class="supporting">
                  {mode === 'cleaner' ? c.lockedHint : c.structureHint}
                </p>
                <dl id="protected-list" class="facts" data-user-content></dl>
              </details>
              <details class="inspection-details">
                <summary>{c.coverage}</summary>
                <p id="coverage"></p>
                <p id="parser-warnings" data-user-content hidden></p>
                <p class="supporting">{c.binaryHint}</p>
                <h3>{c.warning}</h3>
                <p id="limits">{c.faqReaderText}</p>
              </details>
            </div>
          </section>
        </div>
        <section class="notes" aria-labelledby="notes-title">
          <h2 id="notes-title">{c.notes}</h2>
          {mode === 'cleaner' && (
            <>
              <details>
                <summary>{c.faqWhy}</summary>
                <p>{c.faqWhyText}</p>
              </details>
              <details>
                <summary>{c.faqPreserve}</summary>
                <p>{c.faqPreserveText}</p>
              </details>
              <details>
                <summary>{c.faqSafety}</summary>
                <p>{c.faqSafetyText}</p>
              </details>
            </>
          )}
          <details>
            <summary>{c.faqReader}</summary>
            <p>{c.faqReaderText}</p>
          </details>
        </section>
        <MetadataTools lang={lang} active={mode} />
      </main>
      <SiteFooter
        lang={lang}
        source={source}
        issues={`${repository}/issues`}
        licenses="/licenses/NOTICE.txt"
      />
    </div>
    <script>
      import '../scripts/tool.ts';
    </script>
  </body>
</html>
