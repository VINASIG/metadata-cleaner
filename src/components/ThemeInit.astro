<script is:inline>
  (() => {
    let saved = null;
    try {
      saved = localStorage.getItem('vinasig-theme');
    } catch {
      /* Preferences remain optional. */
    }
    const theme =
      saved === 'light' || saved === 'dark'
        ? saved
        : matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
    document.documentElement.dataset.theme = theme;
  })();
</script>
