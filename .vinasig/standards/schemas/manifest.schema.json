{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "format",
    "version",
    "source",
    "files",
    "profile",
    "bundleSha256",
    "agentBlock",
    "agentsCreated"
  ],
  "properties": {
    "format": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "kind"],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "profile": {
      "enum": ["core", "web-static", "web-typescript"]
    },
    "bundleSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "agentBlock": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "agentsCreated": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
