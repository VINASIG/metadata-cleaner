{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "status", "rules"],
  "properties": {
    "format": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["local-candidate", "public-preview", "approved"]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "level",
          "summary",
          "verification",
          "evidence",
          "exceptions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]+-[0-9]{3}$"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": ["MUST", "SHOULD", "MAY"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["automatic", "agent", "human"]
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "exceptions": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
