{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task", "revision", "environment", "checks"],
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": ["string", "null"]
    },
    "environment": {
      "type": "object",
      "required": ["os", "runtime"],
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_APPLICABLE"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
